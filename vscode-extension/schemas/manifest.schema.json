{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fiddlie document manifest",
  "description": "Loaded by fiddlie-manifest. Drives document metadata, current revision, and history.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "revision"],
  "properties": {
    "document": {
      "type": "object",
      "description": "Static document metadata.",
      "additionalProperties": false,
      "required": ["title", "id"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Full document title used in the title block."
        },
        "shorttitle": {
          "type": "string",
          "description": "Short title for running headers."
        },
        "author": {
          "type": "string",
          "description": "Document author."
        },
        "date": {
          "type": "string",
          "description": "Original creation date (free-form, e.g. \"05 May 2026\")."
        },
        "id": {
          "type": "string",
          "description": "Document ID. Use the FD-DC-LTX-##### format for Fiddlie-tracked docs.",
          "pattern": "^FD-DC-LTX-(\\?{5}|\\d{5})$"
        }
      }
    },
    "revision": {
      "type": "object",
      "description": "Current revision state.",
      "additionalProperties": false,
      "required": ["current", "draft"],
      "properties": {
        "current": {
          "type": "string",
          "description": "Revision string. Letters (A, B, C…) for released revisions; suffix -rcN for release candidates.",
          "examples": ["A", "B", "A-rc1", "B-rc2"]
        },
        "draft": {
          "type": "boolean",
          "description": "true while the revision is in progress. fdoc rev lock flips this to false and tags the commit."
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Revision history. fdoc rev next appends an entry here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "date", "author", "changes"],
        "properties": {
          "revision": {
            "type": "string",
            "description": "Revision string for this history entry."
          },
          "date": {
            "type": "string",
            "description": "ISO 8601 date (YYYY-MM-DD).",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "author": {
            "type": "string"
          },
          "changes": {
            "type": "string",
            "description": "Description of the changes in this revision. Replace TODO before locking."
          }
        }
      }
    }
  }
}
