% fiddlie-common.sty - Common styles for all Fiddlie documents
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fiddlie-common}[2025/09/01 Fiddlie Common Styles]

% Graphics support
\RequirePackage{graphicx}

% Require LuaLaTeX for path detection
\RequirePackage{iftex}
\ifluatex
% Use kpse to find assets folder relative to this package
\directlua{
  local pkg_path = kpse.find_file("fiddlie-common.sty", "tex")
  if pkg_path then
  local dir = pkg_path:match("(.*/)") or ""
  local assets_path = dir .. "../assets/"
  tex.print("\\graphicspath{{" .. assets_path .. "}}")
  end
}
\fi

% Useful symbol and color definitions
\RequirePackage{siunitx}
\RequirePackage{xcolor}

% These packages allow full-width tables and combining cells in tables.
\RequirePackage{multirow}
\RequirePackage{multicol}
\RequirePackage{tabularx}
\RequirePackage{threeparttable}

% Include math and code listing tools
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{listings}

\definecolor{dkgreen}{rgb}{0,0.6,0}
\definecolor{mauve}{rgb}{0.58,0,0.82}

% Brand colours — taken from the dots in the Fiddlie logo.
\definecolor{brandpink}{HTML}{FF006E}
\definecolor{brandyellow}{HTML}{FFBE0B}
\definecolor{brandblue}{HTML}{3A86FF}

\lstset{frame=tb,
  aboveskip=8mm,
  belowskip=8mm,
  showstringspaces=false,
  columns=flexible,
  basicstyle={\small\ttfamily},
  numbers=left,
  numberstyle=\tiny\color{gray},
  keywordstyle=\color{blue},
  commentstyle=\color{dkgreen},
  stringstyle=\color{mauve},
  breaklines=true,
  postbreak=\mbox{$\hookrightarrow$\space},
  breakatwhitespace=false,
  tabsize=2,
}

% Allow the doc to be defined as a draft
\newcommand{\draft}{\usepackage{draftwatermark}}

% Align figure and table captions to left.
\RequirePackage[font=bf, skip=5pt, justification=raggedright, format=hang, singlelinecheck=off]{caption}

% Set font
\RequirePackage[]{fontspec}
\setmainfont{Arial}

% Format hyperlinks as blue and set PDF title based on \title{} in the document.
\RequirePackage[pdfusetitle]{hyperref}
\hypersetup{
  breaklinks=true,
  colorlinks=true,
  linkcolor=.,
  urlcolor=blue
}

% Configure page margins (headheight sized for logo in header)
\RequirePackage{geometry}
\geometry{left=2cm, top=3cm, right=2cm, bottom=3cm, headheight=22pt}

% Company logo setup
% Use \setlogo{filename} in preamble to override the default logo
% Use \companylogo or \companylogo[height=1.2cm] to output the logo
\gdef\@logofile{fiddlie-logo}
\newcommand{\setlogo}[1]{\gdef\@logofile{#1}}
\newcommand{\companylogo}[1][height=0.6cm]{\includegraphics[#1]{\@logofile}}

% Load TikZ and libraries for block diagrams
\RequirePackage{tikz}
\usetikzlibrary{positioning, shapes, arrows.meta, fit, babel, quotes}
\pgfdeclarelayer{background}
\pgfsetlayers{background, main}

% Command \revision{} can be used to include a document revision number in footer.
\gdef\@revision{}
\newcommand{\revision}[1]{\gdef\@revision{#1}}
\newcommand{\revisionnumber}{\@revision}

% Command \documentId{} can be used to include a document ID number in footer.
\gdef\@documentId{}
\newcommand{\documentId}[1]{\gdef\@documentId{#1}}

% Command \buildid{} can be used to include a build identifier in footer.
% Reads from .buildid file if it exists, otherwise defaults to "LOCAL - NOT FOR RELEASE".
\gdef\@buildid{LOCAL - NOT FOR RELEASE}
\newcommand{\buildid}[1]{\gdef\@buildid{#1}}

% Register .buildid as a dependency for latexmk and read its content
% Using TeX's \read ensures it's recorded in .fls for latexmk dependency tracking
\newread\buildidreader
\openin\buildidreader=.buildid
\ifeof\buildidreader
% File doesn't exist - keep default
\else
% File exists - read the first line as the build ID
\read\buildidreader to \@tempbuildid
\ifx\@tempbuildid\empty\else
\global\let\@buildid\@tempbuildid
\fi
\fi
\closein\buildidreader

% Command \shorttitle{} can be used to set a shorter title for headers
\gdef\@shorttitle{}
\newcommand{\shorttitle}[1]{\gdef\@shorttitle{#1}}

% Header and footer setup
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{truncate}  % For header text truncation

% First page has footer but no header
\fancypagestyle{firstpage}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{1pt}
  \fancyfoot[L]{\@revision\\{\tiny\@buildid}}
  \fancyfoot[C]{\@date}
  \fancyfoot[R]{Page \thepage\ of \pageref{LastPage}}
}

% Rest of the pages have both header and footer
\fancypagestyle{normalpage}{
  \renewcommand{\headrulewidth}{1pt}
  \renewcommand{\footrulewidth}{1pt}
  \fancyhead[L]{\truncate{7cm}{\leftmark}}
  \fancyhead[C]{\slshape\@shorttitle}
  \fancyhead[R]{\companylogo}
  \fancyfoot[L]{\@revision\\{\tiny\@buildid}}
  \fancyfoot[C]{\@date}
  \fancyfoot[R]{Page \thepage\ of \pageref{LastPage}}
}

% No line above footnotes
\renewcommand\footnoterule{}

% Spacing between paragraphs
\setlength{\parskip}{2ex plus 0.5ex minus 0.2ex}
\setlength{\parindent}{0pt}

% Spacing for tables.
\renewcommand{\arraystretch}{1.5}
\newcommand{\thickhline}{\noalign {\ifnum 0=`}\fi \hrule height 1pt \futurelet \reserved@a \@xhline}

% Caption setup
\captionsetup{justification=centering, margin=2cm}

% First page title layout (using \\ rather than \par to control spacing)
\renewcommand{\maketitle}{%
  {\companylogo[height=1.2cm]}\\
  \vspace{2cm}\\
  {\Huge\bfseries\@title}\\
  \noindent\rule{\textwidth}{1pt}
  \vspace{0.5cm}\\
  {\Large Revision \@revision, \@date}
  \vspace{0.2cm}\\
  \textit{\@documentId}\\
  \medskip
  \pagestyle{normalpage}
  \thispagestyle{firstpage}
}

