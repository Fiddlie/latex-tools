% fiddlie-icons.sty - Font Awesome 7 Pro icon support for Fiddlie documents
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fiddlie-icons}[2026/05/16 Fiddlie FontAwesome Pro Icons]

% LuaLaTeX only — we use kpse + Lua for the name lookup and fontspec for
% the OTF font families.
\RequirePackage{iftex}
\ifluatex\else
  \PackageError{fiddlie-icons}{This package requires LuaLaTeX}{}
\fi

\RequirePackage{fontspec}
\RequirePackage{xparse}
\RequirePackage{luacode}

% Load the name→codepoint Lua table from the latex-tools tree.
% Fonts themselves are resolved via kpse — they're installed to TEXMFHOME
% by `fdoc fonts install` (or `fdoc fonts ensure` lazy-installs on demand).
\directlua{
  local pkg_path = kpse.find_file("fiddlie-icons.sty", "tex")
  local dir = pkg_path and pkg_path:match("(.*/)") or ""
  local icons_path = dir .. "../lua/fa-icons.lua"
  local ok, mod = pcall(dofile, icons_path)
  fa_icons = ok and mod or {codepoints = {}, brand_only = {}}
}

% Every FA7 Pro family exposed as a fontspec family bound to \fa@<style>.
\newfontfamily{\fa@solid}{Font Awesome 7 Pro-Solid-900.otf}
\newfontfamily{\fa@regular}{Font Awesome 7 Pro-Regular-400.otf}
\newfontfamily{\fa@light}{Font Awesome 7 Pro-Light-300.otf}
\newfontfamily{\fa@thin}{Font Awesome 7 Pro-Thin-100.otf}
\newfontfamily{\fa@sharpsolid}{Font Awesome 7 Sharp-Solid-900.otf}
\newfontfamily{\fa@sharpregular}{Font Awesome 7 Sharp-Regular-400.otf}
\newfontfamily{\fa@sharplight}{Font Awesome 7 Sharp-Light-300.otf}
\newfontfamily{\fa@sharpthin}{Font Awesome 7 Sharp-Thin-100.otf}
\newfontfamily{\fa@duotonesolid}{Font Awesome 7 Duotone-Solid-900.otf}
\newfontfamily{\fa@duotoneregular}{Font Awesome 7 Duotone-Regular-400.otf}
\newfontfamily{\fa@duotonelight}{Font Awesome 7 Duotone-Light-300.otf}
\newfontfamily{\fa@duotonethin}{Font Awesome 7 Duotone-Thin-100.otf}
\newfontfamily{\fa@sharpduotonesolid}{Font Awesome 7 Sharp Duotone-Solid-900.otf}
\newfontfamily{\fa@sharpduotoneregular}{Font Awesome 7 Sharp Duotone-Regular-400.otf}
\newfontfamily{\fa@sharpduotonelight}{Font Awesome 7 Sharp Duotone-Light-300.otf}
\newfontfamily{\fa@sharpduotonethin}{Font Awesome 7 Sharp Duotone-Thin-100.otf}
\newfontfamily{\fa@brands}{Font Awesome 7 Brands-Regular-400.otf}
% FA7 novelty families
\newfontfamily{\fa@chisel}{Font Awesome 7 Chisel-Regular-400.otf}
\newfontfamily{\fa@etch}{Font Awesome 7 Etch-Solid-900.otf}
\newfontfamily{\fa@graphite}{Font Awesome 7 Graphite-Thin-100.otf}
