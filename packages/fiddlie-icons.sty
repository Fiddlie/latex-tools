% Lua helper: resolve name+style to a font family + codepoint and print
% the glyph. Errors loudly on unknown name or style — beats silent .notdef.
% Brand-only icons (github, slack, etc.) always render through \fa@brands
% regardless of the requested style.
% Font-family commands live in the @-letter namespace, so we route through
% \csname...\endcsname when emitting from Lua — that's catcode-independent.
\begin{luacode*}
  local style_to_csname = {
    ["solid"]                  = "fa@solid",
    ["regular"]                = "fa@regular",
    ["light"]                  = "fa@light",
    ["thin"]                   = "fa@thin",
    ["sharp"]                  = "fa@sharpsolid",
    ["sharp-solid"]            = "fa@sharpsolid",
    ["sharp-regular"]          = "fa@sharpregular",
    ["sharp-light"]            = "fa@sharplight",
    ["sharp-thin"]             = "fa@sharpthin",
    ["duotone"]                = "fa@duotonesolid",
    ["duotone-solid"]          = "fa@duotonesolid",
    ["duotone-regular"]        = "fa@duotoneregular",
    ["duotone-light"]          = "fa@duotonelight",
    ["duotone-thin"]           = "fa@duotonethin",
    ["sharp-duotone"]          = "fa@sharpduotonesolid",
    ["sharp-duotone-solid"]    = "fa@sharpduotonesolid",
    ["sharp-duotone-regular"]  = "fa@sharpduotoneregular",
    ["sharp-duotone-light"]    = "fa@sharpduotonelight",
    ["sharp-duotone-thin"]     = "fa@sharpduotonethin",
    ["brands"]                 = "fa@brands",
    ["chisel"]                 = "fa@chisel",
    ["etch"]                   = "fa@etch",
    ["graphite"]               = "fa@graphite",
    ["jelly"]                  = "fa@jelly",
    ["jelly-duo"]              = "fa@jellyduo",
    ["jelly-fill"]             = "fa@jellyfill",
    ["notdog"]                 = "fa@notdog",
    ["notdog-duo"]             = "fa@notdogduo",
    ["slab"]                   = "fa@slab",
    ["slab-press"]             = "fa@slabpress",
    ["thumbprint"]             = "fa@thumbprint",
    ["utility"]                = "fa@utility",
    ["utility-duo"]            = "fa@utilityduo",
    ["utility-fill"]           = "fa@utilityfill",
    ["whiteboard"]             = "fa@whiteboard",
  }

  function fa_emit(name, style)
    local cp = fa_icons.codepoints[name]
    if not cp then
      tex.error("fiddlie-icons: unknown icon name '" .. name .. "'")
      return
    end
    local csname
    if fa_icons.brand_only[name] then
      csname = "fa@brands"
    else
      csname = style_to_csname[style]
      if not csname then
        tex.error("fiddlie-icons: unknown style '" .. style .. "'")
        return
      end
    end
    tex.print('{\\csname ' .. csname .. '\\endcsname\\char"' .. cp:upper() .. ' }')
  end
\end{luacode*}

% \faicon[style]{name}
%   Inline icon at the surrounding font size. Default style: solid.
%   Brand icons (e.g. github) auto-route to the Brands family regardless
%   of style. See packages/fiddlie-icons.sty for the full style list.
\NewDocumentCommand{\faicon}{O{solid} m}{%
  \directlua{fa_emit("\luaescapestring{#2}", "\luaescapestring{#1}")}%
}

% \bigicon[style]{size}{name}
%   Larger icon, intended as a lightweight replacement for an inline image
%   in a document. Size is any TeX dimension (3cm, 72pt, 1in, ...).
\NewDocumentCommand{\bigicon}{O{solid} m m}{%
  {\fontsize{#2}{#2}\selectfont
   \directlua{fa_emit("\luaescapestring{#3}", "\luaescapestring{#1}")}}%
}

\endinput
